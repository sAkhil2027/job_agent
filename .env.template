# ==========================================
# Application Configuration & Secrets
# ==========================================

# AI Model API Keys
GROQ_API_KEY="your_groq_api_key_here"
GEMINI_API_KEY="your_gemini_api_key_here"

# Environment & Server Settings
ENVIRONMENT=production
HOST=0.0.0.0
PORT=8000

# Security (Optional API Key Protection for /api/* routes)
# Leave empty for open access in local development, or set a secure token for production.
API_KEY=""

# Database Configuration (PostgreSQL / Supabase recommended for production)
# In production, USE_POSTGRES=true or ENVIRONMENT=production requires DATABASE_URL.
USE_POSTGRES=true
DATABASE_URL="postgresql://postgres:password@host:5432/postgres"

# File Upload Protection (Default: 10MB limit in bytes)
MAX_UPLOAD_SIZE=10485760

# Background Worker Mode
# Set to 'true' for single-process local development.
# Set to 'false' if running worker.py as a separate container/process.
ENABLE_IN_PROCESS_WORKERS=false

# Browser Automation (Playwright)
HEADLESS_MODE=true
BROWSER_PROFILE_DIR=data/browser_profile
SCREENSHOT_DIR=data/screenshots

# Application Worker Retries & Timeouts
MAX_APPLICATION_RETRIES=3
APPLICATION_TIMEOUT=120

# Agent Evaluation & LLM Settings
AGENT_INTERVAL_SECONDS=600
MAX_JOBS_TO_EVALUATE=3
LLM_MODEL="openai/gpt-oss-20b"